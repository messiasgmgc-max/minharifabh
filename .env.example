# URL Base da Aplicação (Vercel ou Local)
NEXT_PUBLIC_APP_URL="https://minharifabh.vercel.app"

# ==============================================================================
# SUPABASE POSTGRESQL (Obter em Project Settings -> Database no Supabase)
# ==============================================================================
# DATABASE_URL: Transaction Pooler (Porta 6543 com pgbouncer=true)
DATABASE_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_SUPABASE]@aws-0-[SUA_REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Connection (Porta 5432 - Necessário para migrações Prisma)
DIRECT_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_SUPABASE]@aws-0-[SUA_REGIAO].supabase.com:5432/postgres"

# ==============================================================================
# MERCADO PAGO API (Obter em https://www.mercadopago.com.br/developers/panel/credentials)
# ==============================================================================
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==============================================================================
# SENHA ADMINISTRATIVA (minharifabh)
# ==============================================================================
ADMIN_PASSWORD="lucas191215"
