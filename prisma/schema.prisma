generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Raffle {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  title                 String
  description           String
  imageUrl              String
  costPrice             Float    @default(0.0)
  totalQuotas           Int
  quotaPrice            Float
  mpFeePercent          Float    @default(0.99)
  drawDate              DateTime
  status                String   @default("ACTIVE")
  hasInstantPrizes      Boolean  @default(false)
  instantPrizesCount    Int      @default(0)
  instantPrizesDetails  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  orders                Order[]
  tickets               Ticket[]
}

model Order {
  id              String   @id @default(uuid())
  raffleId        String
  raffle          Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  buyerName       String
  buyerPhone      String
  buyerEmail      String
  quantity        Int
  totalAmount     Float
  status          String   @default("PENDING")
  mpPaymentId     String?  @unique
  mpQrCode        String?
  mpPixCopiaECola String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tickets         Ticket[]
}

model Ticket {
  id           String   @id @default(uuid())
  raffleId     String
  raffle       Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  number       Int
  isInstantWin Boolean  @default(false)
  instantPrize String?
  createdAt    DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
